# ---- Shopify ----
# Store domain, no https:// and no trailing slash
SHOPIFY_STORE_URL=your-store.myshopify.com
# Admin API access token: Shopify admin > Settings > Apps and sales channels >
# Develop apps > <your app> > API credentials. Starts with shpat_
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional
SHOPIFY_API_VERSION=2026-07
SHOPIFY_API_MODE=rest          # rest | graphql

# ---- Google ----
# The whole service-account JSON file, pasted as one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# ---- Optional ----
# DRY_RUN=1     fetch and show the assignment, write nothing
# LOG_LEVEL=DEBUG
